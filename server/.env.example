# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Base de datos (instancia MariaDB propia del proyecto, puerto 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=restaurante_web
DB_USER=restaurante
DB_PASSWORD=cambiar_esta_clave

# Seguridad
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria_de_64_caracteres
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Subidas
UPLOAD_MAX_MB=5

# Administrador inicial (lo crea `npm run db:seed`; cambia la contraseña antes de desplegar)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@casaveranda.do
ADMIN_PASSWORD=cambiar_esta_clave_de_al_menos_8_caracteres
